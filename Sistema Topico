let chartsInit = false; 
function initCharts(){ 
if(chartsInit) return; chartsInit=true; 
renderReportPatients(); 
// Atenciones por mes 
new Chart(document.getElementById('chartAtenciones').getContext('2d'),{ 
type:'bar', 
data:{ labels:['Ene','Feb','Mar','Abr','May'], datasets:[{ label:'Atenciones', 
data:[3,5,4,6,8], backgroundColor:'#0a91c5', borderRadius:8, borderSkipped:false 
}]}, 
options:{ plugins:{legend:{display:false}}, scales:{ 
y:{beginAtZero:true,grid:{color:'#f0f7fb'}}, x:{grid:{display:false}} }, responsive:true, 
maintainAspectRatio:true } 
}); 
// Motivos de atención 
new Chart(document.getElementById('chartMotivos').getContext('2d'),{ 
type:'doughnut', 
data:{ 
labels:['Cefalea','Dolor abdominal','Crisis hipoglucémica','Fiebre','Reacción 
alérgica','Herida cortante','Traumatismo'], 
datasets:[{ data:[2,1,1,1,1,1,1], 
backgroundColor:['#0a91c5','#10b981','#ef4444','#f97316','#7c3aed','#06b6d4','#84c
c16'], borderWidth:2, borderColor:'#fff' }] 
}, 
options:{ plugins:{legend:{position:'bottom',labels:{font:{size:11},padding:10}}}, 
cutout:'62%', responsive:true, maintainAspectRatio:true } 
}); 
// Stock de medicamentos 
const medLabels = meds.map(m=>m.nombre.split(' ')[0]); 
new Chart(document.getElementById('chartStock').getContext('2d'),{ 
type:'bar', 
data:{ 
labels: medLabels, 
datasets:[ 
{ label:'Stock actual', data:meds.map(m=>m.stock), backgroundColor: 
meds.map(m=>m.stock<m.min?'#f97316':'#0a91c5'), borderRadius:6, 
borderSkipped:false }, 
{ label:'Mínimo requerido', data:meds.map(m=>m.min), 
backgroundColor:'rgba(239,68,68,.25)', borderRadius:6, borderSkipped:false } 
] 
}, 
options:{ plugins:{legend:{position:'top',labels:{font:{size:11}}}}, scales:{ 
y:{beginAtZero:true,grid:{color:'#f0f7fb'}}, x:{grid:{display:false}} }, responsive:true, 
maintainAspectRatio:true } 
}); 
} 
// Slide-in keyframe 
const style = document.createElement('style'); 
style.textContent = `@keyframes slideIn{ 
from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:translateX(0)} 
}`; 
document.head.appendChild(style); 
</script> 
