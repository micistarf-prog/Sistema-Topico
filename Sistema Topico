if(id==='atenciones') renderAtenciones(); 
if(id==='inventario') renderMeds(); 
} 
function capitalize(s){ return s.charAt(0).toUpperCase()+s.slice(1); } 
// ═══════════════════════════════════════════ 
//  AUTH 
// ═══════════════════════════════════════════ 
function showLogin(role){ 
currentRole = role; 
document.getElementById('roleSelect').style.display='none'; 
const lv = document.getElementById('loginView'); 
lv.style.display='flex'; 
const isAdmin = role==='admin'; 
document.getElementById('loginRoleIcon').style.cssText = isAdmin 
? 'background:#e0f2fe;color:#0a91c5;' 
: 'background:#d1fae5;color:#059669;'; 
document.getElementById('loginRoleIcon').innerHTML = `<i class="bi 
${isAdmin?'bi-shield-fill':'bi-heart-pulse-fill'}" style="font-size:1.4rem;"></i>`; 
document.getElementById('loginTitle').textContent = isAdmin ? 'Acceso 
Administrador' : 'Acceso Encargado de Tópico'; 
document.getElementById('demoCreds').textContent = isAdmin ? 'admin / 
admin123' : 'encargado / topico123'; 
document.getElementById('loginUser').value = isAdmin ? 'admin' : 'encargado'; 
document.getElementById('loginPass').value = ''; 
document.getElementById('loginError').style.display='none'; 
} 
function showRoles(){ 
document.getElementById('loginView').style.display='none'; 
document.getElementById('roleSelect').style.display='flex'; 
} 
function doLogin(){ 
const user = document.getElementById('loginUser').value.trim(); 
const pass = document.getElementById('loginPass').value; 
const u = USERS[user]; 
if(!u || u.pass !== pass){ 
document.getElementById('loginError').style.display='block'; return; 
} 
document.getElementById('loginView').style.display='none'; 
const app = document.getElementById('app'); 
app.style.display='block'; 
const role = (user==='admin') ? 'admin' : 'encargado'; 
currentRole = role; 
buildSidebar(role); 
document.getElementById('userAvatar').textContent = u.avatar; 
document.getElementById('userName').textContent = u.name; 
document.getElementById('userRole').textContent = u.role; 
document.getElementById('topUserAvatar').textContent = u.avatar; 
document.getElementById('topUserName').textContent = u.name; 
switchView('dashboard'); 
renderDashboard(); 
} 
function logout(){ 
document.getElementById('app').style.display='none'; 
document.getElementById('roleSelect').style.display='flex'; 
} 
// ═══════════════════════════════════════════ 
//  RENDER 
// ═══════════════════════════════════════════ 
function renderDashboard(){ 
document.getElementById('stPatients').textContent = patients.length; 
document.getElementById('stAtenciones').textContent = atenciones.length; 
document.getElementById('stMeds').textContent = meds.length; 
document.getElementById('stCritical').textContent = 
meds.filter(m=>m.stock<m.min).length; 
const recent = document.getElementById('recentAtenciones'); 
recent.innerHTML = atenciones.slice(0,5).map(a=>` 
<div class="ri"> 
<div class="ri-dot ${a.emergencia?'emergency':'regular'}"></div> 
<div><div class="ri-name">${a.paciente}</div><div class="ri
detail">${a.motivo} — ${a.fecha} a las ${a.hora}${a.emergencia?'&nbsp;<span 
class="badge-status bs-emergency">Emergencia</span>':''}</div></div> 
</div>`).join(''); 
} 
function renderPatients(){ 
const q = (document.getElementById('patSearch')?.value||'').toLowerCase(); 
const filtered = 
patients.filter(p=>!q||p.nombre.toLowerCase().includes(q)||p.dni.includes(q)||p.pr
ograma.toLowerCase().includes(q)); 
document.getElementById('patCountLabel').textContent = `${filtered.length} 
estudiante${filtered.length!==1?'s':''} registrado${filtered.length!==1?'s':''}`; 
document.getElementById('patBody').innerHTML = filtered.map((p,i)=>` 
<tr> 
<td style="font-weight:700;color:var(--primary);font-size:.8rem;">${p.dni}</td> 
<td><div class="td-name">${p.nombre}</div><div class="td-sub">${p.sexo} · 
${p.edad} años</div></td> 
<td style="font-size:.82rem;">${p.programa}</td> 
<td><span class="badge-sem">${p.semestre}</span></td> 
<td style="font-size:.8rem;"><i class="bi bi-telephone me-1" style="color:var(-
muted);"></i>${p.tel}</td> 
      <td><div class="action-icons"> 
        <button title="Ver" onclick="alert('Paciente: ${p.nombre}\\nDNI: 
${p.dni}\\nAlergias: ${p.alergias}')"><i class="bi bi-eye"></i></button> 
        <button title="Historial" onclick="showHistorial('${p.dni}')"><i class="bi bi
journal-text"></i></button> 
        <button title="Editar"><i class="bi bi-pencil"></i></button> 
        <button title="Eliminar" onclick="deletePatient(${i})" style="color:var(-
danger);"><i class="bi bi-trash"></i></button> 
      </div></td> 
    </tr>`).join(''); 
} 
 
function renderAtenciones(){ 
  const q = (document.getElementById('atSearch')?.value||'').toLowerCase(); 
  const filtered = 
atenciones.filter(a=>!q||a.paciente.toLowerCase().includes(q)||a.dni.includes(q)||a
.motivo.toLowerCase().includes(q)); 
  document.getElementById('atCountLabel').textContent = `${filtered.length} 
atención${filtered.length!==1?'es':''} registrada${filtered.length!==1?'s':''}`; 
  document.getElementById('atBody').innerHTML = filtered.map((a,i)=>` 
    <tr> 
      <td><div style="font-size:.8rem;font-weight:600;">${a.fecha}</div><div 
class="td-sub">${a.hora}</div></td> 
      <td><div class="td-name">${a.paciente}</div><div class="td-sub">DNI: 
${a.dni}</div></td> 
      <td style="font-size:.82rem;">${a.motivo}</td> 
      <td style="font-size:.82rem;">${a.diagnostico}</td> 
      <td><span class="badge-status ${a.emergencia?'bs-emergency':'bs
regular'}">${a.estado}</span></td> 
      <td><div class="action-icons"> 
        <button title="Ver detalle" onclick="verAtencion(${i})"><i class="bi bi
eye"></i></button> 
        <button title="Editar"><i class="bi bi-pencil"></i></button> 
      </div></td> 
    </tr>`).join(''); 
} 
 
function renderMeds(critOnly){ 
  const q = (document.getElementById('medSearch')?.value||'').toLowerCase(); 
  let filtered = 
meds.filter(m=>!q||m.nombre.toLowerCase().includes(q)||m.cat.toLowerCase().in
cludes(q)); 
  if(critOnly) filtered = filtered.filter(m=>m.stock<m.min); 
  document.getElementById('medBody').innerHTML = filtered.map((m,i)=>{ 
    const pct = Math.min(100, Math.round(m.stock/m.min*100)); 
    const low = m.stock < m.min; 
    return `<tr> 
      <td><div class="td-name">${low?'<i class="bi bi-exclamation-triangle-fill warn
icon me-1"></i>':''}${m.nombre}</div><div class="td-sub">${m.unidad}</div></td> 
      <td><span style="background:#f0f7fb;color:var(--primary);font
size:.72rem;padding:.2rem .5rem;border-radius:6px;font
weight:600;">${m.cat}</span></td> 
      <td> 
        <div class="stock-bar-wrap"> 
          <span class="stock-num ${low?'low':''}">${m.stock}<div class="td-sub">mín: 
${m.min}</div></span> 
          <div class="stock-bar"><div class="stock-fill ${low?'stock-low':'stock-ok'}" 
style="width:${pct}%;"></div></div> 
        </div> 
      </td> 
      <td style="font-size:.8rem;">${m.venc}</td> 
<td style="font-size:.8rem;">${m.prov}</td> 
<td><div class="action-icons"> 
<button title="Editar"><i class="bi bi-pencil"></i></button> 
<button title="Eliminar" onclick="deleteMed(${i})" style="color:var(-
danger);"><i class="bi bi-trash"></i></button> 
</div></td> 
</tr>`; 
}).join(''); 
} 
function filterCritical(){ renderMeds(true); } 
function renderReportPatients(){ 
const counts = {}; 
atenciones.forEach(a=>{ counts[a.dni]=(counts[a.dni]||0)+1; }); 
const body = document.getElementById('reportPatBody'); 
if(body) body.innerHTML = patients.map(p=>` 
<tr> 
<td class="td-name">${p.nombre}</td> 
<td style="font-size:.8rem;">${p.dni}</td> 
<td style="font-size:.82rem;">${p.programa}</td> 
<td><span 
style="background:${(counts[p.dni]||0)>1?'#e0f2fe':'#f0f7fb'};color:${(counts[p.dni
]||0)>1?'var(--primary)':'var(--muted)'};font-weight:700;padding:.2rem 
.6rem;border-radius:20px;font-size:.8rem;">${counts[p.dni]||0}</span></td> 
</tr>`).join(''); 
} 
// ═══════════════════════════════════════════ 
//  MODALS & ACTIONS 
// ═══════════════════════════════════════════ 
function openModal(id){ 
const el = document.getElementById(id); 
if(!el) return; 
const m = new bootstrap.Modal(el); 
if(id==='modalNuevaAtencion'){ 
const now = new Date(); 
document.getElementById('naFecha').value = now.toISOString().split('T')[0]; 
document.getElementById('naHora').value = now.toTimeString().slice(0,5); 
} 
m.show(); 
} 
function closeModal(id){ 
bootstrap.Modal.getInstance(document.getElementById(id))?.hide(); } 
function savePatient(){ 
const dni=document.getElementById('npDni').value.trim(); 
const nombres=document.getElementById('npNombres').value.trim(); 
const apellidos=document.getElementById('npApellidos').value.trim(); 
if(!dni||!nombres||!apellidos){ alert('Complete los campos obligatorios (*)'); 
return; } 
patients.push({ 
dni, nombre:`${nombres} ${apellidos}`, 
sexo:document.getElementById('npSexo').value, 
edad:parseInt(document.getElementById('npEdad').value)||0, 
programa:document.getElementById('npPrograma').value, 
semestre:document.getElementById('npSemestre').value, 
tel:document.getElementById('npTel').value, 
alergias:document.getElementById('npAlergias').value||'Ninguna' 
}); 
closeModal('modalNuevoPaciente'); 
renderDashboard(); renderPatients(); 
showToast('Paciente registrado exitosamente ✓','success'); 
} 
function saveAtencion(){ 
const pac=document.getElementById('naPaciente').value.trim(); 
const mot=document.getElementById('naMotivo').value; 
const diag=document.getElementById('naDiag').value.trim(); 
if(!pac||mot==='Seleccionar motivo'||!diag){ alert('Complete los campos 
obligatorios (*)'); return; } 
const emergencia = document.getElementById('naEmergencia').checked; 
atenciones.unshift({ 
fecha: document.getElementById('naFecha').value.split('-').reverse().join('/'), 
hora:  document.getElementById('naHora').value, 
paciente: pac, dni:'--------', 
motivo: mot, diagnostico: diag, 
estado: emergencia?'Emergencia':'Regular', 
trat: document.getElementById('naTrat').value, 
meds: document.getElementById('naMeds').value, 
emergencia 
}); 
closeModal('modalNuevaAtencion'); 
renderDashboard(); renderAtenciones(); 
showToast(emergencia ? '    
Atención de emergencia registrada' : 'Atención 
registrada exitosamente ✓', emergencia?'warning':'success'); 
} 
function saveMed(){ 
const nombre=document.getElementById('nmNombre').value.trim(); 
if(!nombre){ alert('Ingrese el nombre del medicamento'); return; } 
meds.push({ 
nombre, cat:document.getElementById('nmCat').value, 
unidad:document.getElementById('nmUnidad').value, 
stock:parseInt(document.getElementById('nmStock').value)||0, 
min:parseInt(document.getElementById('nmMin').value)||10, 
venc:document.getElementById('nmVenc').value, 
prov:document.getElementById('nmProv').value 
}); 
closeModal('modalNuevoMed'); 
renderMeds(); 
showToast('Medicamento registrado exitosamente ✓','success'); 
} 
function deletePatient(i){ if(confirm('¿Eliminar este paciente?')){ 
patients.splice(i,1); renderPatients(); renderDashboard(); } } 
function deleteMed(i){ if(confirm('¿Eliminar este medicamento?')){ 
meds.splice(i,1); renderMeds(); renderDashboard(); } } 
function verAtencion(i){ 
const a = atenciones[i]; 
document.getElementById('modalVerAtencionBody').innerHTML = ` 
<dl class="row" style="font-size:.85rem;"> 
<dt class="col-4">Paciente</dt><dd class="col-8">${a.paciente} 
(${a.dni})</dd> 
<dt class="col-4">Fecha / Hora</dt><dd class="col-8">${a.fecha} 
${a.hora}</dd> 
<dt class="col-4">Motivo</dt><dd class="col-8">${a.motivo}</dd> 
<dt class="col-4">Diagnóstico</dt><dd class="col-8">${a.diagnostico}</dd> 
<dt class="col-4">Tratamiento</dt><dd class="col-8">${a.trat||'—'}</dd> 
<dt class="col-4">Medicamentos</dt><dd class="col-8">${a.meds||'—'}</dd> 
<dt class="col-4">Estado</dt><dd class="col-8"><span class="badge-status 
${a.emergencia?'bs-emergency':'bs-regular'}">${a.estado}</span></dd> 
</dl>`; 
openModal('modalVerAtencion'); 
} 
function showHistorial(dni){ 
const ats = atenciones.filter(a=>a.dni===dni); 
const p = patients.find(px=>px.dni===dni); 
alert(`Historial de ${p?p.nombre:dni}:\n\n${ats.length?ats.map(a=>`• ${a.fecha} 
${a.hora}: ${a.motivo} → ${a.diagnostico}`).join('\n'):'Sin atenciones 
registradas.'}`); 
} 
function filterPatientsQuick(){ 
const q = document.getElementById('quickSearch').value.toLowerCase().trim(); 
const res = document.getElementById('quickResults'); 
if(!q){ res.style.display='none'; return; } 
const filtered = 
patients.filter(p=>p.nombre.toLowerCase().includes(q)||p.dni.includes(q)); 
res.style.display='block'; 
res.innerHTML = filtered.length ? filtered.map(p=>` 
<div style="padding:.4rem .6rem;border-radius:8px;background:#f5fafd;margin
bottom:.3rem;font-size:.82rem;"> 
<b>${p.nombre}</b> — DNI: ${p.dni} — ${p.programa} 
</div>`).join('') : '<div style="font-size:.82rem;color:var(--muted);">No se 
encontraron resultados.</div>'; 
} 
// ═══════════════════════════════════════════ 
//  TOAST 
// ═══════════════════════════════════════════ 
function showToast(msg, type='success'){ 
let container = document.getElementById('toastContainer'); 
if(!container){ 
container = document.createElement('div'); 
container.id='toastContainer'; 
container.style.cssText='position:fixed;bottom:1.5rem;right:1.5rem;z
index:9999;display:flex;flex-direction:column;gap:.5rem;'; 
document.body.appendChild(container); 
} 
const t = document.createElement('div'); 
const bg = type==='success'?'var(--success)':type==='warning'?'var(-
accent)':'var(--danger)'; 
t.style.cssText=`background:${bg};color:#fff;padding:.65rem 1.1rem;border
radius:10px;font-size:.84rem;font-weight:600;box-shadow:0 4px 16px 
rgba(0,0,0,.15);animation:slideIn .25s ease;`; 
t.textContent = msg; 
container.appendChild(t); 
setTimeout(()=>t.remove(), 3000); 
} 
